# Salin file ini menjadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development

# WAJIB diganti dengan teks acak panjang (minimal 32 karakter)
# Cara membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Batas nilai ketuntasan capaian pembelajaran (KKM)
KKM=70

# Lokasi file database (opsional)
# DB_FILE=./data/sekolah.db

# Isi 1 bila di belakang reverse proxy / hosting HTTPS (Nginx, Railway, Render, dll)
# TRUST_PROXY=1
